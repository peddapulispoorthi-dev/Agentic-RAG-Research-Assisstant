# ==============================================================================
# Agentic RAG Research Assistant - Production Environment Variables Configuration
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# API Credentials
GOOGLE_API_KEY=your_google_gemini_api_key_here
TAVILY_API_KEY=your_tavily_web_search_api_key_here

# Production Observability & LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agentic-rag-research-assistant

# Retrieval & Vectorstore Index Directories
INDEX_DIR=data/index
RAW_DIR=data/raw